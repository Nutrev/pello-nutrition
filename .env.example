# Copy this file to .env.local and fill in your keys
# Get your Anthropic API key at: https://console.anthropic.com

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — for real review scraping (see README.md)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# RAINFOREST_API_KEY=

# Password for /admin (any username works). Required — admin is locked if unset.
ADMIN_PASSWORD=choose_a_strong_password

# Supabase — URL and anon key are public; the service-role key is server-only (never prefix it NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Brand logos (free publishable key from https://logo.dev). Without it, logos fall back
# to local PNGs and Google favicons.
NEXT_PUBLIC_LOGO_DEV_TOKEN=
